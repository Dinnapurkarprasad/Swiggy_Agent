# Copy to .env and fill in. Never commit .env.

APP_ENV=local
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# Async SQLAlchemy URL (Supabase / Neon / local Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/swiggy_party

# mock | staging | production
SWIGGY_MODE=mock
SWIGGY_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_OAUTH_CLIENT_ID=
SWIGGY_OAUTH_CLIENT_SECRET=
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:8000/swiggy/oauth/callback

# Encrypts Swiggy OAuth tokens at rest. Required outside mock mode.
TOKEN_ENCRYPTION_KEY=

LLM_PROVIDER=gemini
GOOGLE_API_KEY=
